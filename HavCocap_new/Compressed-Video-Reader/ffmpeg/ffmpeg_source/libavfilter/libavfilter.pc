prefix=../ffmpeg_install
exec_prefix=${prefix}
libdir=../ffmpeg_install/lib
includedir=../ffmpeg_install/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 8.44.100
Requires: libswscale >= 6.7.100, libavformat >= 59.27.100, libavcodec >= 59.37.100, libswresample >= 4.7.100, libavutil >= 57.28.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavfilter -pthread -lm -latomic
Libs.private: 
Cflags: -I${includedir}
